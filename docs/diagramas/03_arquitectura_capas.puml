@startuml
!include estilo.puml
' Figura 3: Arquitectura lógica en capas (dependencias en un solo sentido)
skinparam packageStyle rectangle
skinparam shadowing false
title Arquitectura lógica de SARIF (MVC en capas)

package "resources/sarif/vista" as vista <<Vista>> {
  [Login.fxml]
  [Principal.fxml]
  [Tablero.fxml / Zonas.fxml / ...]
  [sarif.css]
}
package "sarif.controlador" as controlador <<Controlador>>
package "sarif.servicio" as servicio <<Control de casos de uso>>
package "sarif.fuentes" as fuentes <<Interfaz con servicios externos>>
package "sarif.datos" as datos <<Acceso a datos (JDBC)>>
package "sarif.modelo" as modelo <<Entidades>>

database "MySQL 8.0\nbase sarif" as bd
cloud "NASA FIRMS" as firms
cloud "Open-Meteo" as meteo
cloud "Copernicus\nSentinel Hub" as sentinel
cloud "Copernicus GWIS\n(índice FWI)" as gwis
cloud "OpenTopoMap" as topo
folder "cache/\n(mosaicos e imágenes NDVI)" as cache

vista ..> controlador : fx:controller
controlador --> servicio
servicio --> fuentes
servicio --> datos
datos --> bd : JDBC
fuentes --> firms : HTTPS GET (CSV)
fuentes --> meteo : HTTPS GET (CSV y JSON)
fuentes --> sentinel : HTTPS POST (OAuth2, JSON -> PNG)
fuentes --> gwis : HTTPS GET (WMS, GeoTIFF)
fuentes --> topo : HTTPS GET (teselas PNG)
fuentes --> cache : mosaicos e imágenes NDVI

controlador ..> modelo
servicio ..> modelo
fuentes ..> modelo
datos ..> modelo
@enduml
