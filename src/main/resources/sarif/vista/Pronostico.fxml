<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Pronóstico": pronóstico extendido de cada zona (16 días de Open-Meteo) con el vector del
    viento (velocidad, ráfagas y dirección), la lluvia, la humedad del aire y del suelo y la
    evapotranspiración. Los días que cumplen la regla 30-30-30 se resaltan en rojo.
    El controlador es PronosticoControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.PronosticoControlador" spacing="12" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label fx:id="lblTitulo" styleClass="titulo-seccion"/>
            <Label fx:id="lblCarga" styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Zona"/>
        <ComboBox fx:id="cmbZona" prefWidth="260"/>
        <!-- Trae de Open-Meteo los 16 días de todas las zonas activas (sincronización meteorológica de hoy). -->
        <Button fx:id="btnActualizar" text="Actualizar pronóstico" onAction="#actualizarPronostico"
                styleClass="boton-principal"/>
    </HBox>
    <Label fx:id="lblPermiso" styleClass="aviso-permiso" visible="false" managed="false"/>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFecha" text="Día" prefWidth="95"/>
            <TableColumn fx:id="colTipo" text="Dato" prefWidth="85"/>
            <TableColumn fx:id="colTemperatura" text="Temp. máx / mín (°C)" prefWidth="125"/>
            <TableColumn fx:id="colHumedad" text="Humedad mín. (%)" prefWidth="105"/>
            <TableColumn fx:id="colViento" text="Viento máx. (km/h)" prefWidth="110"/>
            <TableColumn fx:id="colRafaga" text="Ráfagas (km/h)" prefWidth="95"/>
            <TableColumn fx:id="colDireccion" text="Dirección (de → hacia)" prefWidth="140"/>
            <TableColumn fx:id="colLluvia" text="Lluvia (mm)" prefWidth="80"/>
            <TableColumn fx:id="colProbLluvia" text="Prob. lluvia (%)" prefWidth="95"/>
            <TableColumn fx:id="colSuelo" text="Humedad suelo (%)" prefWidth="110"/>
            <TableColumn fx:id="colEvapotranspiracion" text="Evapotransp. (mm)" prefWidth="110"/>
        </columns>
    </TableView>

    <VBox spacing="4" styleClass="leyenda">
        <Label fx:id="lblResumen" styleClass="texto-destacado" wrapText="true"/>
        <Label wrapText="true" styleClass="texto-secundario"
               text="Dirección: de dónde viene el viento, y la flecha hacia dónde empujaría el fuego. En rojo, los días que cumplen la regla 30-30-30 (más de 30 °C, menos de 30 % de humedad y más de 30 km/h de viento). Humedad del suelo de 0 a 10 cm: por debajo de 10 % el suelo y la vegetación están muy secos. Evapotranspiración: agua que pierden el suelo y las plantas en el día."/>
        <Label fx:id="lblMensaje" styleClass="mensaje-info" wrapText="true"/>
    </VBox>
</VBox>
