<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Fuentes de datos": las conexiones que usa SARIF en un solo lugar.
    Arriba, la tabla con el servicio satelital, el meteorológico y los archivos del modo sin conexión,
    con su estado y los botones para probarlos. Abajo, la configuración de la sincronización (producto
    satelital, intervalo de la programada y días de focos). La clave de FIRMS no se edita acá: va en
    config/sarif.local.properties. El controlador es FuentesControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.FuentesControlador" spacing="12" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Fuentes de datos" styleClass="titulo-seccion"/>
            <Label text="Servicios externos y archivos de respaldo que usa la sincronización."
                   styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnProbar" text="Probar conexión" onAction="#probarSeleccionada"/>
        <Button fx:id="btnProbarTodas" text="Probar todas" onAction="#probarTodas" styleClass="boton-principal"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNombre" text="Fuente" prefWidth="140"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="170"/>
            <TableColumn fx:id="colDireccion" text="Dirección o ruta" prefWidth="230"/>
            <TableColumn fx:id="colConfiguracion" text="Configuración" prefWidth="260"/>
            <TableColumn fx:id="colUltima" text="Última sincronización" prefWidth="150"/>
            <!-- Estado con color y texto (clases fuente-* del CSS). -->
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
        </columns>
    </TableView>
    <!-- Detalle de la fila seleccionada: el resultado completo de la última prueba. -->
    <Label fx:id="lblDetalle" styleClass="mensaje-info" wrapText="true"/>

    <!-- Configuración de la sincronización. -->
    <VBox spacing="8" styleClass="tarjeta">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <Label text="Configuración de la sincronización" styleClass="texto-destacado"/>
        <GridPane hgap="10" vgap="8">
            <Label text="Producto satelital" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbProducto" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Sincronización programada cada (minutos)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Spinner fx:id="spMinutos" editable="true" prefWidth="110" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Días de focos por sincronización programada" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Spinner fx:id="spDias" editable="true" prefWidth="110" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="La clave de NASA FIRMS se configura en config/sarif.local.properties (firms.clave) y no se muestra completa."
                   styleClass="texto-secundario" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnGuardar" text="Guardar configuración" onAction="#guardar" styleClass="boton-principal"/>
        </HBox>
        <!-- Probar las conexiones lo puede hacer cualquiera; cambiar la configuración, solo el administrador. -->
        <Label fx:id="lblPermisoConfig" wrapText="true" styleClass="aviso-permiso"/>
        <Label text="Sensores y estaciones de campo del organismo: previstos como requerimiento candidato RC07 (evolución futura)."
               styleClass="texto-secundario" wrapText="true"/>
    </VBox>
</VBox>
