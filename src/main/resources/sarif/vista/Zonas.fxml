<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Zonas" (CU01 Registrar zona, CU04 y CU05 Activar y desactivar vigilancia, CU12 Actualizar
    nivel de alerta). A la izquierda queda la lista de zonas y a la derecha un panel con scroll con dos
    formularios: alta de zona y cambio de nivel de alerta de la zona seleccionada.
    El controlador es ZonasControlador. Los campos con asterisco son obligatorios.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.ZonasControlador" spacing="16" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Lista de zonas (CU04 / CU05). Ocupa todo el ancho que deja libre el panel lateral. -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Zonas de vigilancia" styleClass="titulo-seccion"/>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260"/>
                <!-- Activa o Inactiva, con color y texto (clases vigilancia-* del CSS). -->
                <TableColumn fx:id="colVigilancia" text="Vigilancia" prefWidth="100"/>
                <!-- Rectángulo o polígono; en un polígono, las latitudes y longitudes son las del rectángulo que lo encierra. -->
                <TableColumn fx:id="colForma" text="Forma" prefWidth="110"/>
                <TableColumn fx:id="colLatitudes" text="Latitudes" prefWidth="130"/>
                <TableColumn fx:id="colLongitudes" text="Longitudes" prefWidth="130"/>
            </columns>
        </TableView>
        <!-- Estos botones actúan sobre la zona seleccionada en la tabla. -->
        <HBox spacing="8">
            <Button text="Activar vigilancia" onAction="#activarVigilancia"/>
            <Button text="Desactivar vigilancia" onAction="#desactivarVigilancia"/>
        </HBox>
    </VBox>

    <!-- Panel lateral con scroll, para que los formularios entren aunque la ventana sea baja. -->
    <ScrollPane fitToWidth="true" prefWidth="420" minWidth="380" styleClass="panel-lateral">
        <VBox spacing="12">
            <!-- Alta de zona (CU01). Uso un GridPane de dos columnas: etiqueta a la izquierda y campo a la derecha. -->
            <TitledPane text="Nueva zona" collapsible="false">
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nombre *" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Descripción" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <!-- Coordenadas en grados decimales; los promptText muestran valores de ejemplo de la zona cordillerana. -->
                    <Label text="Latitud mín. / máx. *" GridPane.rowIndex="2"/>
                    <HBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <TextField fx:id="txtLatMin" promptText="-37.950" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtLatMax" promptText="-37.750" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label text="Longitud mín. / máx. *" GridPane.rowIndex="3"/>
                    <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <TextField fx:id="txtLonMin" promptText="-71.200" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtLonMax" promptText="-70.950" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <!-- Solo se ve cuando la zona viene dibujada como polígono desde la pestaña Mapa de riesgo. -->
                    <HBox fx:id="boxPoligono" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false"
                          GridPane.rowIndex="4" GridPane.columnIndex="1">
                        <Label fx:id="lblPoligono" wrapText="true" styleClass="texto-destacado" HBox.hgrow="ALWAYS"/>
                        <Button text="Quitar" onAction="#quitarPoligono"/>
                    </HBox>
                    <!-- Datos del primer relevamiento de combustible de la zona. -->
                    <Label text="Combustible *" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="cmbCombustible" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Carga (t/ha) *" GridPane.rowIndex="6"/>
                    <TextField fx:id="txtCarga" promptText="15.5" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label text="Fecha relevamiento *" GridPane.rowIndex="7"/>
                    <DatePicker fx:id="dpRelevamiento" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    <Button text="Registrar zona" onAction="#registrarZona" styleClass="boton-principal"
                            GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                </GridPane>
            </TitledPane>

            <!-- Cambio de nivel de alerta (CU12). Se refiere a la zona que esté seleccionada en la tabla. -->
            <TitledPane text="Nivel de alerta de la zona" collapsible="false">
                <VBox spacing="8">
                    <Label fx:id="lblZonaSeleccionada" text="Seleccione una zona de la lista" styleClass="texto-destacado"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Nivel vigente:"/>
                        <Label fx:id="lblNivelVigente" text="—" styleClass="texto-destacado"/>
                    </HBox>
                    <!-- NDVI de Sentinel-2 (RC05): informativo, no interviene en el índice. -->
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Vegetación (NDVI):"/>
                        <Label fx:id="lblNdvi" text="—" wrapText="true" styleClass="texto-destacado"/>
                    </HBox>
                    <Label text="Nuevo nivel *"/>
                    <ComboBox fx:id="cmbNivel" maxWidth="Infinity"/>
                    <!-- El fundamento es obligatorio: deja constancia de por qué se cambió el nivel. -->
                    <Label text="Fundamento del cambio *"/>
                    <TextArea fx:id="txtFundamento" prefRowCount="3" wrapText="true"
                              promptText="Motivo del cambio (índice, focos, pronóstico...)"/>
                    <Button fx:id="btnCambioNivel" text="Registrar cambio de nivel" onAction="#registrarCambioNivel" styleClass="boton-principal"/>
                    <!-- Aviso que aparece si el rol no puede cambiar el nivel (lo decide el jefe de guardia). -->
                    <Label fx:id="lblPermisoNivel" wrapText="true" styleClass="aviso-permiso"/>
                </VBox>
            </TitledPane>

            <!--
                Relevamiento de combustible posterior al alta (RFS21), para la zona seleccionada. Cada carga
                agrega un relevamiento nuevo; el anterior queda en el historial.
            -->
            <TitledPane text="Relevamiento de combustible" collapsible="false">
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Vigente:" GridPane.rowIndex="0"/>
                    <Label fx:id="lblCombustibleVigente" text="—" wrapText="true" styleClass="texto-destacado"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Combustible *" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbRelTipo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Carga (t/ha) *" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtRelCarga" promptText="18.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Fecha *" GridPane.rowIndex="3"/>
                    <DatePicker fx:id="dpRelFecha" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Observaciones" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtRelObservaciones" promptText="Recorrida de mitad de temporada"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Button text="Registrar relevamiento" onAction="#registrarRelevamiento" styleClass="boton-principal"
                            GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
            </TitledPane>
        </VBox>
    </ScrollPane>
</HBox>
