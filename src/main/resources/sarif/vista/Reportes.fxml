<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Reportes" (CU13 Generar reportes, RFS18 y RFS19).
    Arriba se elige el período y, para la cronología, la zona. "Generar" arma los reportes y "Exportar HTML..."
    guarda todo en un archivo para abrirlo en el navegador, imprimirlo o guardarlo como PDF.
    Hay dos solapas: la cronología de la guardia (cada alerta, notificación, cierre, cambio de nivel y
    asignación con fecha, hora, nivel de alerta vigente y responsable) y el histórico con el desempeño del índice.
    El controlador es ReportesControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.ReportesControlador" spacing="10" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Período, zona y acciones. -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Reportes de la guardia" styleClass="titulo-seccion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Desde"/>
        <DatePicker fx:id="dpDesde" prefWidth="130"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="dpHasta" prefWidth="130"/>
        <Label text="Zona"/>
        <ComboBox fx:id="cmbZona" prefWidth="210"/>
        <Button text="Generar" onAction="#generar" styleClass="boton-principal"/>
        <Button fx:id="btnExportar" text="Exportar HTML..." onAction="#exportar"/>
    </HBox>
    <!-- Confirma que el reporte se generó (y con qué datos), para que el botón no parezca no hacer nada. -->
    <Label fx:id="lblGenerado" styleClass="texto-secundario" wrapText="true"/>

    <TabPane fx:id="solapas" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Cronología de la guardia">
            <VBox spacing="8">
                <padding><Insets top="10"/></padding>
                <Label fx:id="lblResumen" styleClass="mensaje-info" wrapText="true"/>
                <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colMomento" text="Fecha y hora" prefWidth="115"/>
                        <TableColumn fx:id="colEventoZona" text="Zona" prefWidth="170"/>
                        <TableColumn fx:id="colHito" text="Hito" prefWidth="150"/>
                        <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="420"/>
                        <!-- Nivel de alerta vigente de la zona en ese momento (clases alerta-* del CSS). -->
                        <TableColumn fx:id="colNivelAlerta" text="Nivel de alerta" prefWidth="105"/>
                        <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="120"/>
                        <!-- Para la notificación y el cierre o descarte: cuánto pasó desde que se generó la alerta. -->
                        <TableColumn fx:id="colDemora" text="Desde la alerta" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Focos, índices y desempeño">
            <VBox spacing="10">
                <padding><Insets top="10"/></padding>
                <!-- RFS18: focos e índices por zona. -->
                <Label text="Focos e índices por zona" styleClass="texto-destacado"/>
                <TableView fx:id="tablaZonas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colZona" text="Zona" prefWidth="230"/>
                        <TableColumn fx:id="colFocos" text="Focos" prefWidth="60"/>
                        <TableColumn fx:id="colAlta" text="Confianza alta" prefWidth="100"/>
                        <TableColumn fx:id="colFrp" text="FRP prom. (MW)" prefWidth="100"/>
                        <TableColumn fx:id="colDias" text="Días con índice" prefWidth="100"/>
                        <TableColumn fx:id="colPromedio" text="Índice prom." prefWidth="90"/>
                        <TableColumn fx:id="colMaximo" text="Índice máx." prefWidth="90"/>
                        <TableColumn fx:id="colAltos" text="Días ALTO o EXTREMO" prefWidth="130"/>
                    </columns>
                </TableView>

                <!-- RFS19: desempeño del índice. -->
                <Label text="Desempeño del índice: riesgo previsto frente a focos detectados" styleClass="texto-destacado"/>
                <TableView fx:id="tablaDesempeno" prefHeight="170">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <!-- Nivel con color y texto (clases nivel-* del CSS). -->
                        <TableColumn fx:id="colNivel" text="Nivel previsto" prefWidth="140"/>
                        <TableColumn fx:id="colDiasZona" text="Días-zona" prefWidth="90"/>
                        <TableColumn fx:id="colDiasFocos" text="Días con focos" prefWidth="110"/>
                        <TableColumn fx:id="colPorcentaje" text="Días con focos (%)" prefWidth="120"/>
                        <TableColumn fx:id="colFocosNivel" text="Focos" prefWidth="80"/>
                    </columns>
                </TableView>
                <Label fx:id="lblConclusion" styleClass="mensaje-info" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
