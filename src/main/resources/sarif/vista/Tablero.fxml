<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Tablero de riesgo" (CU06 Tablero de riesgo y CU09 Calcular índice a pedido).
    Es la pantalla inicial después del ingreso: muestra cada zona con su índice de riesgo (0 a 100),
    el nivel de riesgo y el nivel de alerta vigente, más una leyenda con los rangos de cada nivel.
    El controlador es TableroControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.TableroControlador" spacing="12" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Encabezado: el título y el resumen los completa el controlador porque dependen de la fecha y los datos. -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label fx:id="lblTitulo" styleClass="titulo-seccion"/>
            <Label fx:id="lblResumen" styleClass="texto-secundario"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Actualizar" onAction="#actualizar"/>
        <!-- CU09: calcula el índice del día para las zonas. -->
        <Button text="Calcular índice del día" onAction="#calcularIndice" styleClass="boton-principal"/>
    </HBox>

    <!--
        Aviso de sincronización fallida (RFS20). Queda oculto (managed="false" no ocupa lugar) y el
        controlador lo muestra solo cuando la última sincronización de focos o de meteorología falló.
    -->
    <Label fx:id="lblAvisos" styleClass="aviso-falla" wrapText="true" maxWidth="Infinity"
           visible="false" managed="false"/>

    <!-- Tabla principal del tablero (CU06). -->
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colZona" text="Zona" prefWidth="300"/>
            <TableColumn fx:id="colVigilancia" text="Vigilancia" prefWidth="100"/>
            <TableColumn fx:id="colFecha" text="Fecha del índice" prefWidth="120"/>
            <TableColumn fx:id="colIndice" text="Índice (0-100)" prefWidth="110" styleClass="columna-numero"/>
            <!-- Los dos niveles se muestran como etiquetas con color y texto (clases nivel-* y alerta-*). -->
            <TableColumn fx:id="colNivelRiesgo" text="Nivel de riesgo" prefWidth="140"/>
            <TableColumn fx:id="colNivelAlerta" text="Nivel de alerta" prefWidth="140"/>
        </columns>
    </TableView>

    <!--
        Leyenda de niveles de riesgo con los rangos del índice. Uso las mismas clases CSS que las celdas
        de la tabla, así los colores coinciden. El texto de cada etiqueta repite el nombre del nivel para
        no depender solo del color. A la derecha queda el mensaje del último cálculo.
    -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="leyenda">
        <Label text="Niveles de riesgo:" styleClass="texto-secundario"/>
        <Label text="BAJO  0 a 25" styleClass="etiqueta, nivel-BAJO"/>
        <Label text="MODERADO  25 a 50" styleClass="etiqueta, nivel-MODERADO"/>
        <Label text="ALTO  50 a 75" styleClass="etiqueta, nivel-ALTO"/>
        <Label text="EXTREMO  75 a 100" styleClass="etiqueta, nivel-EXTREMO"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblMensaje" styleClass="mensaje-info"/>
    </HBox>
</VBox>
