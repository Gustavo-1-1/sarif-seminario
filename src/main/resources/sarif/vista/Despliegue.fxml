<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Despliegue" (CU10 Sugerir despliegue preventivo y CU11 Registrar asignación).
    El operador pide una sugerencia de qué recurso mandar a cada zona según el riesgo del día, la revisa
    y la ajusta (cambiar la zona de una fila, agregar una asignación a mano o quitar filas) y recién al
    confirmar se guarda en la base.
    El controlador es DespliegueControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.DespliegueControlador" spacing="12" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Encabezado: título, mensaje de estado y botón para generar la sugerencia (CU10). -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Despliegue preventivo de recursos" styleClass="titulo-seccion"/>
            <Label fx:id="lblMensaje" styleClass="texto-secundario" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Sugerir despliegue" onAction="#sugerir" styleClass="boton-principal"/>
    </HBox>

    <!-- Propuesta de asignaciones: una fila por recurso sugerido para una zona. Vive solo en memoria. -->
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colZona" text="Zona" prefWidth="250"/>
            <TableColumn fx:id="colIndice" text="Índice" prefWidth="70"/>
            <!-- Nivel de riesgo con color y texto (clases nivel-* del CSS). -->
            <TableColumn fx:id="colNivel" text="Nivel" prefWidth="110"/>
            <TableColumn fx:id="colRecurso" text="Recurso" prefWidth="180"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
            <TableColumn fx:id="colDotacion" text="Dotación" prefWidth="75"/>
            <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="230"/>
        </columns>
    </TableView>

    <!--
        Ajuste de la sugerencia (CU10 paso 5 y flujo S3). La zona elegida se usa para cambiar la zona de la
        fila seleccionada o, junto con un recurso disponible, para agregar una asignación manual.
    -->
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="tarjeta">
        <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
        <Label text="Zona:"/>
        <ComboBox fx:id="cmbZona" prefWidth="260"/>
        <Button text="Cambiar zona de la fila" onAction="#cambiarZona"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Recurso:"/>
        <ComboBox fx:id="cmbRecurso" prefWidth="220"/>
        <Button text="Agregar asignación" onAction="#agregarAsignacion"/>
    </HBox>

    <!-- Revisión y confirmación (CU11). Confirmar usa el estilo oscuro porque es la acción que escribe en la base. -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <!-- Cualquiera que opere puede pedir y ajustar la sugerencia; confirmarla lo decide el jefe de guardia. -->
        <Label fx:id="lblPermisoAsignar" wrapText="true" styleClass="aviso-permiso"/>
        <Button text="Quitar fila" onAction="#quitarFila"/>
        <Button fx:id="btnConfirmar" text="Confirmar asignaciones" onAction="#confirmar" styleClass="boton-peligro"/>
    </HBox>
</VBox>
