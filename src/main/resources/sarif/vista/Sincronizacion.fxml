<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pestaña "Sincronización" (CU07 Sincronizar focos, CU08 Sincronizar meteorología e importación
    histórica RFS08). Desde acá el operador trae los focos de calor de FIRMS y el pronóstico de
    Open-Meteo, ya sea desde archivos locales (para trabajar sin conexión) o desde internet.
    El controlador es SincronizacionControlador.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sarif.controlador.SincronizacionControlador" spacing="12" styleClass="pestana">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Encabezado con la fecha de trabajo que se va a sincronizar. -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Sincronización de datos externos" styleClass="titulo-seccion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblFecha" styleClass="texto-secundario"/>
    </HBox>

    <!-- Tarjeta de opciones: fuente de datos, cantidad de días de focos y botones de cada operación. -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="tarjeta">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <Label text="Fuente:" styleClass="texto-destacado"/>
        <!-- El ToggleGroup hace que los dos RadioButton sean excluyentes. Arranca en archivo; si hay clave de FIRMS, el controlador elige la remota. -->
        <fx:define><ToggleGroup fx:id="grupoFuente"/></fx:define>
        <RadioButton fx:id="rbArchivo" text="Archivo (sin conexión)" toggleGroup="$grupoFuente" selected="true"/>
        <RadioButton fx:id="rbRemota" text="Remota (FIRMS / Open-Meteo)" toggleGroup="$grupoFuente"/>
        <Separator orientation="VERTICAL"/>
        <!-- Los límites del spinner (1 a 10 días) los configuro en el controlador. FIRMS acepta hasta
             5 días por consulta, así que la fuente remota parte los rangos más largos en tramos. -->
        <Label text="Días de focos:"/>
        <Spinner fx:id="spDias" prefWidth="70"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Importar histórico..." onAction="#importarHistorico"/>
        <Button text="Sincronizar focos" onAction="#sincronizarFocos" styleClass="boton-principal"/>
        <Button text="Sincronizar meteorología" onAction="#sincronizarMeteo" styleClass="boton-principal"/>
        <!-- NDVI de Sentinel-2 (RC05): siempre remoto, no tiene archivo de respaldo. -->
        <Button text="Sincronizar NDVI (Sentinel-2)" onAction="#sincronizarNdvi"/>
    </HBox>

    <!--
        Sincronización programada (RFS07, CU07 y CU08): cada cierta cantidad de minutos (parámetro
        sincronizacion_minutos) trae focos y meteorología con la fuente elegida arriba. Si la remota
        falla, el servicio pasa solo a la fuente de archivo.
    -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="tarjeta">
        <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
        <CheckBox fx:id="chkProgramada" text="Sincronización programada" onAction="#cambiarProgramada"
                  styleClass="texto-destacado"/>
        <Label fx:id="lblProgramada" styleClass="texto-secundario"/>
    </HBox>

    <!-- Carga manual de meteorología (RFS12), como respaldo cuando no hay servicio ni archivo. -->
    <TitledPane text="Carga manual de meteorología (respaldo)" expanded="false">
        <GridPane hgap="10" vgap="8">
            <Label text="Zona *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbZonaMeteo" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Fecha *" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dpFechaMeteo" prefWidth="130" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <CheckBox fx:id="chkPronostico" text="Es pronóstico" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
            <Label text="Temp. máx. (°C) *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTemperatura" promptText="31.5" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Humedad mín. (%) *" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtHumedad" promptText="18" prefWidth="130" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <Label text="Viento máx. (km/h) *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtViento" promptText="42" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Precipitación (mm)" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <TextField fx:id="txtPrecipitacion" promptText="0" prefWidth="130" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <!-- Opcional (RC06): si se deja vacío, el índice se calcula sin la humedad del suelo. -->
            <Label text="Humedad del suelo (m³/m³)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtHumedadSuelo" promptText="0,25" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Button text="Cargar registro" onAction="#cargarMeteoManual" styleClass="boton-principal"
                    GridPane.rowIndex="3" GridPane.columnIndex="3"/>
        </GridPane>
    </TitledPane>

    <!-- Registro de texto de lo que pasó en esta sesión, con hora. Es de solo lectura. -->
    <Label text="Resultado de las operaciones" styleClass="texto-destacado"/>
    <TextArea fx:id="txtRegistro" editable="false" prefRowCount="4" wrapText="true" styleClass="registro"/>

    <!-- Historial guardado en la base con las últimas sincronizaciones. -->
    <Label text="Últimas sincronizaciones" styleClass="texto-destacado"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="Id" prefWidth="45"/>
            <TableColumn fx:id="colFecha" text="Inicio" prefWidth="130"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="70"/>
            <TableColumn fx:id="colOrigen" text="Origen" prefWidth="80"/>
            <!-- Resultado OK o FALLIDA con color y texto (clases resultado-* del CSS). -->
            <TableColumn fx:id="colResultado" text="Resultado" prefWidth="90"/>
            <TableColumn fx:id="colNuevos" text="Nuevos" prefWidth="70"/>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="520"/>
        </columns>
    </TableView>
</VBox>
